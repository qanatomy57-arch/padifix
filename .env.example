# ============================================================================
# PADIFIX MARKETPLACE — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Production URL: https://padifix.vercel.app
# ============================================================================

# ==========================================
# 1. APPLICATION BASE
# ==========================================
# Scope: Public / Client-safe
APP_URL=https://padifix.vercel.app


# ==========================================
# 2. SUPABASE POSTGRESQL & AUTH
# ==========================================
# Obtain from: Supabase Dashboard -> Project Settings -> API
# SUPABASE_URL: Public / Client-safe
SUPABASE_URL=https://hvxosxhnxauiqrhpyuur.supabase.co
# SUPABASE_ANON_KEY: Public / Client-safe (Protected by PostgreSQL RLS)
SUPABASE_ANON_KEY=
# (Optional) Modern Supabase publishable key alias:
SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY: SERVER-ONLY (Bypasses RLS; NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=


# ==========================================
# 3. PAYSTACK PAYMENT GATEWAY (NIGERIA NGN)
# ==========================================
# Obtain from: Paystack Dashboard -> Settings -> API Keys & Webhooks
# PAYSTACK_PUBLIC_KEY: Public / Client-safe (Used for client-side popup checkout)
PAYSTACK_PUBLIC_KEY=
# PAYSTACK_SECRET_KEY: SERVER-ONLY (Used for charge initialization & HMAC-SHA512 webhook verification; Paystack signs using Secret Key)
PAYSTACK_SECRET_KEY=
# PAYMENT_LIVE_MODE: Set to true only when using live production Paystack keys (pk_live/sk_live)
PAYMENT_LIVE_MODE=false


# ==========================================
# 4. RESEND TRANSACTIONAL EMAIL API
# ==========================================
# Obtain from: Resend Dashboard -> API Keys / Domains
# RESEND_API_KEY: SERVER-ONLY (Used for serverless outbound email dispatches)
RESEND_API_KEY=
# RESEND_FROM_EMAIL: Public / Client-safe display sender
RESEND_FROM_EMAIL=PadiFix <notifications@padifix.ng>


# ==========================================
# 5. SENTRY ERROR & PERFORMANCE MONITORING
# ==========================================
# Obtain from: Sentry Dashboard -> Project Settings -> Client Keys (DSN)
# SENTRY_DSN: Public / Client-safe (Browser & serverless error event ingestion endpoint)
SENTRY_DSN=
# SENTRY_AUTH_TOKEN: SERVER-ONLY (Used for Sentry CLI release tracking & source-map upload; NEVER expose to client)
SENTRY_AUTH_TOKEN=
# SENTRY_ORG: Server-only (Sentry organization slug for CI/CLI release tracking)
SENTRY_ORG=
# SENTRY_PROJECT: Server-only (Sentry project slug for CI/CLI release tracking)
SENTRY_PROJECT=
# SENTRY_ENVIRONMENT: Public (e.g. development, preview, production)
SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE: Public (Performance tracing sampling rate: 0.0 to 1.0)
SENTRY_TRACES_SAMPLE_RATE=0.10
# SENTRY_REPLAYS_SESSION_SAMPLE_RATE: Public (Session replay sampling rate: 0.0 to 1.0)
SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.05
# SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE: Public (Replay on error capture sampling rate: 0.0 to 1.0)
SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0


# ==========================================
# 6. CLOUDFLARE EDGE, DNS & WAF — DEFERRED
# ==========================================
# STATUS: DEFERRED — Awaiting PadiFix custom domain acquisition.
# Do not configure DNS, zones, or API tokens until custom domain is secured.
# CLOUDFLARE_ACCOUNT_ID: SERVER-ONLY (Account ID from dashboard sidebar)
CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ZONE_ID: SERVER-ONLY (Zone ID for padifix.ng domain)
CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_API_TOKEN: SERVER-ONLY (Scoped token with Zone:Read, DNS:Edit, Cache Purge)
CLOUDFLARE_API_TOKEN=


# ==========================================
# 7. GOOGLE MAPS PLATFORM
# ==========================================
# Obtain from: Google Cloud Console -> Google Maps Platform -> Keys & Credentials
# GOOGLE_MAPS_API_KEY: Public / Client-safe (MUST be restricted by HTTP referrer & enabled APIs)
# Required APIs: Maps JavaScript API, Places API (New), Geocoding API
# Allowed Referrers: https://padifix.vercel.app/*, https://*.vercel.app/*, http://localhost:*/*, http://127.0.0.1:*/*
GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_MAP_ID: Public / Client-safe (Optional vector/cloud map styling ID)
GOOGLE_MAPS_MAP_ID=
# (Optional server-side key - only if future backend geocoding without client referrer is required):
# GOOGLE_MAPS_SERVER_API_KEY=


# ==========================================
# 8. TRUST & SAFETY COMPLIANCE DESK
# ==========================================
# Obtain: Generate 32-byte hex key (e.g. via crypto.randomBytes(32).toString('hex'))
# PADIFIX_ADMIN_KEY: SERVER-ONLY (Master key for /admin.html & /api/admin-compliance; NEVER expose to client)
PADIFIX_ADMIN_KEY=
# ADMIN_EMAILS: SERVER-ONLY (Comma-separated allowlist of authorized administrator emails)
ADMIN_EMAILS=admin@padifix.ng,compliance@padifix.ng


# ==========================================
# 9. TERMII TRANSACTIONAL SMS & ARTISAN ALERTS
# ==========================================
# Obtain from: https://termii.com -> Dashboard -> Settings -> API Tokens
# TERMII_API_KEY: SERVER-ONLY (Used for transactional SMS dispatch to artisans upon contact)
TERMII_API_KEY=
# TERMII_SENDER_ID: Sender alphanumeric header (Approved on Termii, e.g. PadiFix, or default N-Alert)
TERMII_SENDER_ID=PadiFix
# TERMII_BASE_URL: Termii API endpoint (default: https://api.ng.termii.com)
TERMII_BASE_URL=https://api.ng.termii.com
# TERMII_CHANNEL: SMS delivery route - 'generic' (default) or 'dnd' (for Nigerian DND bypass)
TERMII_CHANNEL=generic


# ============================================================================
# CRITICAL SECURITY INVARIANTS:
# 1. NEVER commit real secret keys into version control (.env is strictly gitignored).
# 2. Server-only keys (PAYSTACK_SECRET_KEY, RESEND_API_KEY, TERMII_API_KEY, SENTRY_AUTH_TOKEN,
#    CLOUDFLARE_API_TOKEN, SUPABASE_SERVICE_ROLE_KEY, PADIFIX_ADMIN_KEY) must NEVER be delivered to the browser.
# 3. Client keys (GOOGLE_MAPS_API_KEY) MUST use Google Cloud HTTP referrer restrictions.
# ============================================================================

